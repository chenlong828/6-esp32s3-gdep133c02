# 局域网刷屏固件 —— ESP32-133C02-IL（ESP32-S3R8，16 MB Flash / 8 MB PSRAM）
# ESP-IDF 5.4.x
#
# 与 firmware/jpg2bin_bench 同一套硬件配置；差别在于本固件同时跑
# WiFi + HTTP + FATFS + 面板，不追求单点跑分，因此用 -Os。

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPI_MASTER_IN_IRAM=y

# 8 MB octal PSRAM：任务 3 的整帧缓冲（960 018 B）+ HTTP 接收缓冲都在这里
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# 日志走原生 USB-Serial-JTAG（/dev/cu.usbmodem1101），与 e6_epd 一致
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FATFS：长文件名 + UTF-8 + 512 B 扇区（归档文件名带时间戳，需要 LFN）
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_VOLUME_COUNT=2

# HTTP 服务：上传 960 KB 需要足够的栈与头部空间
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 面板整屏刷新 12~19 s，期间刷屏任务一直占着 CPU 时间片但会阻塞等待 BUSY，
# 任务看门狗按任务粒度喂；这里放宽到 60 s 避免误判。
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
